<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableIdentifierGeneration>true</EnableIdentifierGeneration>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GenerateIdentifierAttribute.fs" CompileOrder="CompileBefore" />
    <Compile Include="Identifiers.fs" />
    <Compile Include="Scheduling.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

</Project>
