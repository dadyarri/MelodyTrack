<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableMigrationGeneration>true</EnableMigrationGeneration>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MelodyTrack.Rewrite.Persistence/MelodyTrack.Rewrite.Persistence.csproj" />
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="appsettings.Development.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="Migrations/*.sql;Migrations/README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Migrations/*.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <InternalsVisibleTo Include="MelodyTrack.Rewrite.Init.Tests" />
  </ItemGroup>
</Project>
