<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <MigrationDirectory>$(MSBuildProjectDirectory)/Fixtures/Migrations</MigrationDirectory>
    <MigrationNamespace>MelodyTrack.Rewrite.Init.Tests.Fixtures</MigrationNamespace>
    <EnableMigrationGeneration>true</EnableMigrationGeneration>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../build/MigrationGeneration.cs" Link="Build/MigrationGeneration.cs" />
    <Compile Include="../MelodyTrack.Rewrite.Api.Tests/WebAuthnTestAuthenticator.cs" Link="Fixtures/WebAuthnTestAuthenticator.cs" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildToolsPath)/Microsoft.Build.Framework.dll" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildToolsPath)/Microsoft.Build.Utilities.Core.dll" />
    <ProjectReference Include="../../src/MelodyTrack.Rewrite.Init/MelodyTrack.Rewrite.Init.csproj" />
    <ProjectReference Include="../../src/MelodyTrack.Rewrite.Api/MelodyTrack.Rewrite.Api.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/MelodyTrack.Rewrite.Init/Migrations/*.sql"
          Link="Schema/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
</Project>
