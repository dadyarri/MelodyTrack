<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <MigrationDirectory>$(MSBuildProjectDirectory)/Fixtures/Migrations</MigrationDirectory>
    <MigrationNamespace>MelodyTrack.Rewrite.Init.Tests.Fixtures</MigrationNamespace>
    <EnableMigrationGeneration>true</EnableMigrationGeneration>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../build/MigrationGeneration.fs" Link="Build/MigrationGeneration.fs" />
    <Compile Include="PostgreSqlFixture.fs" />
    <Compile Include="Fixtures/Helpers.fs" />
    <Compile Include="MigrationTests.fs" />
    <Compile Include="MigrationRunnerTests.fs" CompileOrder="CompileAfter" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MelodyTrack.Rewrite.Init\MelodyTrack.Rewrite.Init.fsproj" />
  </ItemGroup>

</Project>
