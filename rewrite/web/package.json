{
  "name": "melodytrack-rewrite-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "api:generate": "node ../scripts/generate-api-client.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/run-playwright.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "biome check --write .",
    "verify": "biome check . && npm run typecheck && npm run test && vite build",
    "verify:fix": "npm run format && npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@microsoft/kiota-abstractions": "1.0.0-preview.112",
    "@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.112",
    "@microsoft/kiota-serialization-form": "1.0.0-preview.112",
    "@microsoft/kiota-serialization-json": "1.0.0-preview.112",
    "@microsoft/kiota-serialization-multipart": "1.0.0-preview.112",
    "@microsoft/kiota-serialization-text": "1.0.0-preview.112",
    "@tabler/icons-react": "3.52.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-paginate": "8.3.0",
    "react-router": "8.5.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
