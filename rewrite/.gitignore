# Build output and editor files inherit the repository's root .gitignore.

# Local environment and configuration overrides.
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.*.local.json
appsettings.Development.json

# Application release metadata is source data, not build output.
!changelog/releases/
!changelog/releases/*.json

# Local verification artifacts (may contain detailed diagnostics).
.artifacts/
scripts/__pycache__/
scripts/tests/__pycache__/
