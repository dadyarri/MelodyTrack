<Project>
  <PropertyGroup>
    <MigrationDirectory Condition="'$(MigrationDirectory)' == ''">$(MSBuildProjectDirectory)/Migrations</MigrationDirectory>
    <MigrationNamespace Condition="'$(MigrationNamespace)' == ''">$(RootNamespace)</MigrationNamespace>
    <GeneratedMigrationRegistry>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'GeneratedMigrations.cs'))</GeneratedMigrationRegistry>
  </PropertyGroup>
  <UsingTask TaskName="MelodyTrack.Rewrite.Build.GenerateMigrationRegistry"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)MigrationGeneration.cs" />
    </Task>
  </UsingTask>
  <ItemGroup>
    <Compile Include="$(GeneratedMigrationRegistry)" Link="Generated/GeneratedMigrations.cs" />
  </ItemGroup>
  <Target Name="GenerateMigrationRegistry" BeforeTargets="BeforeCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <GenerateMigrationRegistry Directory="$(MigrationDirectory)" Output="$(GeneratedMigrationRegistry)" Namespace="$(MigrationNamespace)" />
    <ItemGroup>
      <FileWrites Include="$(GeneratedMigrationRegistry)" />
    </ItemGroup>
  </Target>
</Project>
