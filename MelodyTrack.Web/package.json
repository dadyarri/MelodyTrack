{
  "name": "melodytrack-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsgo -b && npm run build:vite",
    "build:vite": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint:biome": "biome lint .",
    "lint:architecture": "steiger ./src",
    "check:assets": "node ./scripts/check-public-assets.mjs",
    "check:bundle": "node ./scripts/check-build-budget.mjs",
    "check:css-compat": "node ./scripts/check-css-compatibility.mjs",
    "check:security": "node ./scripts/check-security-baseline.mjs",
    "check:url-copy": "node ./scripts/check-url-copy-boundary.mjs",
    "analyze": "vite build --mode analyze",
    "typecheck": "tsgo -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:webkit": "node ./scripts/run-webkit-tests.mjs",
    "test:webkit:direct": "vitest run --config vitest.webkit.config.ts",
    "test:watch": "vitest",
    "verify:static": "npm run format:check && npm run lint:biome && npm run lint && npm run lint:architecture && npm run check:assets && npm run check:css-compat && npm run check:security && npm run check:url-copy && npm run typecheck",
    "verify:unit": "npm run test",
    "verify:chromium": "npm run test:browser",
    "verify:bundle": "npm run build:vite && npm run check:bundle",
    "verify:primary": "npm run verify:static && npm run verify:unit && npm run verify:chromium && npm run verify:bundle",
    "verify": "npm run verify:primary && npm run test:webkit",
    "verify:fix": "npm run format && npm run lint:fix && npm run verify"
  },
  "browserslist": [
    "iOS >= 16.4",
    "Safari >= 16.4",
    "Chrome >= 109",
    "Edge >= 109",
    "Firefox >= 115"
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@xyflow/react": "^12.11.0",
    "antd": "^6.4.2",
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "dexie": "^4.4.4",
    "libphonenumber-js": "^1.13.3",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.3.0",
    "sceditor": "^3.2.1",
    "valibot": "^1.4.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "browserslist": "^4.28.7",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "playwright": "1.61.0",
    "postcss": "^8.5.23",
    "rollup-plugin-visualizer": "^7.0.1",
    "steiger": "^0.6.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
