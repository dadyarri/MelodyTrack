<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClosedXML" />
        <PackageReference Include="Facet" />
        <PackageReference Include="Facet.Extensions.EFCore" />
        <PackageReference Include="Facet.Mapping" />
        <PackageReference Include="FastEndpoints" />
        <PackageReference Include="FastEndpoints.Generator">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FastEndpoints.Security" />
        <PackageReference Include="FastEndpoints.Swagger" />
        <PackageReference Include="Humanizer.Core" />
        <PackageReference Include="Humanizer.Core.ru" />
        <PackageReference Include="Ical.Net" />
        <PackageReference Include="Isopoh.Cryptography.Argon2" />
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Otp.NET" />
        <PackageReference Include="QRCoder" />
        <PackageReference Include="Quartz" />
        <PackageReference Include="Quartz.AspNetCore" />
        <PackageReference Include="Quartz.Serialization.SystemTextJson" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="SerilogTracing.Expressions" />
        <PackageReference Include="SerilogTracing.Instrumentation.AspNetCore" />
        <PackageReference Include="SixLabors.Fonts" />
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" />
        <PackageReference Include="UaDetector" />
        <PackageReference Include="Ulid" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Update="common_passwords.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>

        <None Include="..\changelog\**\*">
            <Link>changelog\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MelodyTrack.Backend.Tests" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MelodyTrack.Core\MelodyTrack.Core.csproj" />
      <ProjectReference Include="..\MelodyTrack.Data\MelodyTrack.Data.csproj" />
      <ProjectReference Include="..\MelodyTrack.ServiceDefaults\MelodyTrack.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
